<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
     Unhook — FINAL manifest.

     PRIVACY POLICY (Pillar P1):
       * There is deliberately NO android.permission.INTERNET. The app
         cannot reach the network even if its code tried.
       * No ad, analytics, Firebase or crash-upload SDK is linked.
       * Cloud backup and device-to-device transfer are fully disabled.
       * Every permission is requested only behind a plain-English
         why-screen (OnboardingActivity).
     ===================================================================== -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground-app detection. AppOp granted in Settings > Usage access. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Interstitial overlay. On API 29+ holding this is also the official
         exemption that allows the background interstitial launch. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Detection foreground service (specialUse, see below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification visibility on API 33+ (service runs even if denied). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm detection after reboot / app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility: launcher apps only (trigger-app picker). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".UnhookApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_unhook"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unhook">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".interstitial.InterstitialActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Unhook" />

        <service
            android:name=".detection.DetectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Required by Play for targetSdk 34+: why specialUse is needed.
                 Declared formally in the Play Console form (milestone 10). -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="digital_wellbeing_usage_monitor" />
        </service>

        <receiver
            android:name=".detection.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
